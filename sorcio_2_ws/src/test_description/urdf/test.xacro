<link name="optical_left_ultrasonic_sensor_link">
</link>

<link name="optical_center_ultrasonic_sensor_link">
</link>

<link name="optical_right_ultrasonic_sensor_link">
</link>

<joint name="chassis_joint" type="fixed">
  <origin xyz="-0.02425 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="chassis_link"/>
</joint>

<joint name="motor_right_joint" type="fixed">
  <origin xyz="0.0 -0.038 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_motor_link"/>
</joint>

<joint name="left_motor_joint" type="fixed">
  <origin xyz="0.0 0.038 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_motor_link"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="0.0 -0.0145 0.0" rpy="0 0 0"/>
  <parent link="right_motor_link"/>
  <child link="right_wheel_link"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="0.0 0.0145 0.0" rpy="0 0 0"/>
  <parent link="left_motor_link"/>
  <child link="left_wheel_link"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Rigido 6" type="fixed">
  <origin xyz="0.05075 0.0 -0.0025" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="passive_wheel_link"/>
</joint>

<joint name="Rigido 7" type="fixed">
  <origin xyz="0.04475 0.05250 0.012" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_ultrasonic_sensor_link"/>
</joint>

<joint name="Rigido 8" type="fixed">
  <origin xyz="0.07575 0.0 0.012" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="center_ultrasonic_sensor_link"/>
</joint>

<joint name="Rigido 9" type="fixed">
  <origin xyz="0.04475 -0.05250 0.012" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_ultrasonic_sensor_link"/>
</joint>

<joint name="optical_left_ultrasonic_sensor_joint" type="fixed">
  <origin xyz="0.04475 0.05250 0.012" rpy="0 0 ${pi/2}"/>
  <parent link="base_link"/>
  <child link="optical_left_ultrasonic_sensor_link"/>
</joint>

<joint name="optical_center_ultrasonic_sensor_joint" type="fixed">
  <parent link="base_link"/>
  <child link="optical_center_ultrasonic_sensor_link"/>
  <origin xyz="0.07575 0.0 0.012" rpy="0 0 0"/>
</joint>

<joint name="optical_right_ultrasonic_sensor_joint" type="fixed">
  <parent link="base_link"/>
  <child link="optical_right_ultrasonic_sensor_link"/>
  <origin xyz="0.04475 -0.05250 0.012" rpy="0 0 ${-pi/2}"/>
</joint>

</robot>
